generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model DigitalCard {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  jobTitle  String?
  company   String?
  email     String
  phone     String?
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("digital_card")
}